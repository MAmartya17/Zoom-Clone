# SQLAlchemy URL. Swap for postgresql+psycopg://... to move off SQLite.
DATABASE_URL=sqlite:///./zoom_clone.db
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Frontend base URL, used to build invite links.
PUBLIC_APP_URL=http://localhost:3000
# Seed demo data automatically when the database is empty.
SEED_ON_STARTUP=true
# Seconds an empty live meeting waits before it is ended automatically.
EMPTY_ROOM_GRACE_SECONDS=60
